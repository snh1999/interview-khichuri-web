{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!src/components/ui",
      "!**/*.mjs",
      "!**/*.json",
      "!**/*.config.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedInterfaceMembers": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": "off",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "variable"
                },
                "formats": [
                  "camelCase",
                  "CONSTANT_CASE",
                  "PascalCase",
                  "snake_case"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/api/**/*.{js,jsx,ts,tsx}",
        "src/lib/auth/auth-client.ts"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useExplicitType": "off"
          }
        }
      }
    }
  ]
}
